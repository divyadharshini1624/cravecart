# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL / hosted PostgreSQL connection string.
# Configure this in AI Studio Secrets or your environment.
# NEVER commit real credentials to Git or expose to client JavaScript.
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Secret key for signing session tokens
JWT_SECRET="cravecart-jwt-super-secret-placeholder-token"

# PORT: Server port (defaults to 3000 in AI Studio)
PORT="3000"

